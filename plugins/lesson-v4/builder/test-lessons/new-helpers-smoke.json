{
  "lessonName": "New Helpers Smoke Test",
  "yearGroup": "Year 4",
  "subject": "Maths",
  "lo": "Smoke test for number-network, area-grid, reflection-grid, measuring-jug",
  "slides": [
    {
      "template": "body-full",
      "headerStyle": "title",
      "title": "Number network — question",
      "instruction": "Every connected pair adds up to 60. Find the missing circles.",
      "body": {
        "type": "number-network",
        "target": 60,
        "nodes": [
          { "x": 1, "y": 0, "value": 25 },
          { "x": 1, "y": 1, "value": 35 },
          { "x": 0, "y": 2, "value": null },
          { "x": 2, "y": 2, "value": null }
        ],
        "edges": [[0, 1], [1, 2], [1, 3]]
      }
    },
    {
      "template": "body-full",
      "headerStyle": "title",
      "title": "Number network — answers",
      "instruction": "Every connected pair adds up to 60.",
      "body": {
        "type": "number-network",
        "target": 60,
        "nodes": [
          { "x": 1, "y": 0, "value": 25 },
          { "x": 1, "y": 1, "value": 35 },
          { "x": 0, "y": 2, "value": 25, "color": "00B050" },
          { "x": 2, "y": 2, "value": 25, "color": "00B050" }
        ],
        "edges": [[0, 1], [1, 2], [1, 3]]
      }
    },
    {
      "template": "body-full",
      "headerStyle": "title",
      "title": "Area grid — question",
      "instruction": "Each square is 1 m squared. Find the area of each patch.",
      "body": {
        "type": "area-grid",
        "cols": 10,
        "rows": 6,
        "unitLabel": "Each square = 1m²",
        "rects": [
          { "x": 0, "y": 0, "w": 4, "h": 3, "label": "A" },
          { "x": 5, "y": 1, "w": 3, "h": 4, "label": "B" },
          { "x": 8, "y": 0, "w": 2, "h": 2, "label": "C" }
        ]
      }
    },
    {
      "template": "body-full",
      "headerStyle": "title",
      "title": "Reflection grid — question",
      "instruction": "Reflect the shape in the mirror line.",
      "body": {
        "type": "reflection-grid",
        "cols": 10,
        "rows": 8,
        "mirror": { "orientation": "vertical", "at": 5 },
        "shape": [[2, 2], [2, 6], [4, 6], [4, 4], [3, 4], [3, 2]]
      }
    },
    {
      "template": "body-full",
      "headerStyle": "title",
      "title": "Reflection grid — answer",
      "instruction": "Reflect the shape in the mirror line.",
      "body": {
        "type": "reflection-grid",
        "cols": 10,
        "rows": 8,
        "mirror": { "orientation": "vertical", "at": 5 },
        "shape": [[2, 2], [2, 6], [4, 6], [4, 4], [3, 4], [3, 2]],
        "showReflection": true
      }
    },
    {
      "template": "body-full",
      "headerStyle": "title",
      "title": "Measuring jug — question",
      "instruction": "Mark the level at 250 ml.",
      "body": {
        "type": "measuring-jug",
        "max": 400,
        "majorEvery": 100,
        "minorEvery": 50,
        "unit": "ml",
        "label": "Mark 250ml"
      }
    },
    {
      "template": "body-full",
      "headerStyle": "title",
      "title": "Measuring jug — answer",
      "instruction": "The level shows 250 ml.",
      "body": {
        "type": "measuring-jug",
        "max": 400,
        "majorEvery": 100,
        "minorEvery": 50,
        "value": 250,
        "unit": "ml",
        "levelColor": "00B050",
        "label": "250ml"
      }
    }
  ]
}
