      }
    },
    {
      "template": "body-full",
      "headerStyle": "title",
      "title": "Diagonal-up mirror — answer",
      "instruction": "Reflect the shape in the diagonal mirror line.",
      "body": {
        "type": "reflection-grid",
        "cols": 8, "rows": 8,
        "mirror": { "orientation": "diagonal-up", "at": 0 },
        "shape": [[1,3],[1,6],[3,6],[3,5],[2,5],[2,3]],
        "showReflection": true
      }
    },
    {
      "template": "body-full",
      "headerStyle": "title",
      "title": "Diagonal-down mirror — answer",
      "instruction": "Reflect the shape in the diagonal mirror line.",
      "body": {
        "type": "reflection-grid",
        "cols": 8, "rows": 8,
        "mirror": { "orientation": "diagonal-down", "at": 6 },
