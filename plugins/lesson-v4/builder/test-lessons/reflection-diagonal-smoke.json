{
  "lessonName": "Reflection Diagonal Smoke Test",
  "yearGroup": "Year 4",
  "subject": "Maths",
  "lo": "I can reflect a shape in a mirror line, including a diagonal one.",
  "slides": [
    {
      "template": "body-full",
      "headerStyle": "title",
