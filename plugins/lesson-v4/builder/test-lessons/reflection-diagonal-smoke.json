      "body": {
        "type": "reflection-grid",
        "cols": 10, "rows": 8,
        "mirror": { "orientation": "horizontal", "at": 4 },
        "shape": [[2,5],[2,7],[5,7],[5,6],[3,6],[3,5]],
        "showReflection": true
      }
    },
    {
      "template": "body-full",
      "headerStyle": "title",
