# A working copy of the Educational SVG drawings, if one is checked out beside
# the plugin. The drawings belong to DynoDS/educational-svg and are fetched as
# they are chosen; committing them here would put 135,610 files into this
# repository's history permanently, and every plugin install would download
# them for ever after, whether or not they were still in the folder.
/educational-svg/

__pycache__/
*.pyc
.pytest_cache/

# Built lessons, test output and one-off scripts that collect in this checkout.
# They are products of runs, not part of the plugin, and committing them would
# put finished lessons into the plugin's history permanently.
/lesson-output/
/lesson-resources-output/
/emw-output/
/output/
/outputs/
/proof-runs/
/working/
/tmp/
/_qa_math_ltp_numbered/
/error.log
/add_lesson_numbers.py
/fix_lesson_number_column.py
/inspect_docx.py
