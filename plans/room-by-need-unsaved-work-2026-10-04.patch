+++ b/plugins/lesson-v4/builder/test/layout-options.test.js
@@ -0,0 +1,184 @@
+'use strict';
+
+// A refused two-part slide is told which two-part layouts hold it.
+//
+// Year 4 Maths Lesson 16 (Roman numerals to L, 22 September 2026) had six
+// slides refused as top-and-bottom splits and spent three repair passes and a
+// focused repair on them; each lays out cleanly side by side. Year 4 Maths
+// Lesson 21 (3 October 2026) had four answer slides that no two-part layout
+// holds. Both are things the engine can find in seconds and the slide designer
+// could only find a pass at a time. These tests pin that the check says so,
+// and that it never names a layout it has not actually drawn.
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const os = require('node:os');
+const path = require('node:path');
+const { spawnSync } = require('node:child_process');
+
+const { layoutOptions, groupFor, sideFor } = require('../scripts/layout-options');
+
+const CHECK = path.join(__dirname, '..', 'scripts', 'check-slide-design.js');
+
+const CRITERIA = {
+  type: 'sc-panel',
+  content: {
+    type: 'steps',
+    items: [
+      'Find any pairs: IV, IX or XL.',
+      'For each pair, subtract the smaller value from the larger.',
+      'Add the values of the pairs and the other letters.',
+    ],
+  },
+};
+
+// The Roman numerals My Turn as the run wrote it: a task and a reference table
+// in the top part, the success criteria underneath.
+function topAndBottom() {
+  return {
+    template: 'split-v-60-40',
+    primarySide: 'top',
+    title: 'My Turn - reading',
+    primary: {
+      type: 'stack',
+      heightRatio: 0.75,
+      items: [
+        { type: 'text', value: 'Write each Roman numeral as an ordinary number.\nXXVI\nXLVI', align: 'center', weight: 0.7 },
+        {
+          type: 'table',
+          weight: 1,
+          headers: ['Letter', 'I', 'V', 'X', 'L'],
+          rows: [['Value', '1', '5', '10', '50'], ['Subtraction pairs', 'IV = 4', 'IX = 9', 'XL = 40', '']],
+        },
+      ],
+    },
+    secondary: CRITERIA,
+  };
+}
+
+// Two calculations, each with a finished number line, under a four-row working
+// table: more than one column of any two-part layout holds.
+function tooFull() {
+  return {
+    template: 'split-h-50-50',
+    primarySide: 'left',
+    title: 'Answers',
+    primary: {
+      type: 'stack',
+      items: [
+        { type: 'text', value: 'Work out each subtraction.', weight: 0.8 },
+        { type: 'text', value: 'Use the jumps to help you.', weight: 0.8 },
+        {
+          type: 'table',
+          weight: 1.6,
+          headers: ['Working'],
+          rows: [['76 - 30 = 46; 46 - 2 = 44'], ['76 - 32 = 44'], ['69 - 20 = 49; 49 - 5 = 44'], ['69 - 25 = 44']],
+        },
+        { type: 'text', value: '(1) 76 - 32 =', weight: 0.8 },
+        { type: 'numberline', weight: 1.5, start: 44, end: 76, labels: [44, 46, 76] },
+        { type: 'text', value: '(2) 69 - 25 =', weight: 0.8 },
+        { type: 'numberline', weight: 1.5, start: 44, end: 69, labels: [44, 49, 69] },
+      ],
+    },
+    secondary: CRITERIA,
+  };
+}
+
+function lessonOf(...slides) {
+  return { lessonName: 'Layout Options', subject: 'Maths', lo: 'Check layout options', slides };
+}
+
+function runCheck(lesson) {
+  const root = fs.mkdtempSync(path.join(os.tmpdir(), 'layout-options-'));
+  const lessonPath = path.join(root, 'lesson.json.tmp.layout-options');
+  fs.writeFileSync(lessonPath, JSON.stringify(lesson));
+  const result = spawnSync(process.execPath, [CHECK, lessonPath], { encoding: 'utf8', maxBuffer: 20 * 1024 * 1024 });
+  const left = fs.readdirSync(root);
+  fs.rmSync(root, { recursive: true, force: true });
+  return { output: `${result.stdout || ''}${result.stderr || ''}`, left };
+}
+
+const noAutofit = (output) => /AUTOFIT_(DEPENDENCY_MISSING|NOT_PERMITTED)/.test(output);
+
+test('a slide refused top and bottom is told the side-by-side layouts that hold it', () => {
+  const { output, left } = runCheck(lessonOf(topAndBottom()));
+  if (noAutofit(output)) return;
+
+  assert.match(output, /TABLE_ZONE_TOO_SHORT/, `the fixture is no longer refused:\n${output.slice(-900)}`);
+  const line = output.split(/\r?\n/).find((l) => l.startsWith('LAYOUT_OPTIONS: slide 1:'));
+  assert.ok(line, `a refused two-part slide got no layout line:\n${output.slice(-900)}`);
+  assert.match(line, /`split-h-\d+-\d+`/, `no side-by-side layout was named: ${line}`);
+  assert.doesNotMatch(line, /`split-v-60-40`/, 'the refused layout was offered back');
+  assert.deepEqual(left, ['lesson.json.tmp.layout-options'], 'the trial deck was left beside the lesson');
+});
+
+test('a layout the check names really does build the slide', () => {
+  const { output } = runCheck(lessonOf(topAndBottom()));
+  if (noAutofit(output)) return;
+  const line = output.split(/\r?\n/).find((l) => l.startsWith('LAYOUT_OPTIONS: slide 1:')) || '';
+  const named = /`(split-[hv]-\d+-\d+)`/.exec(line);
+  assert.ok(named, `nothing was named to try: ${line}`);
+
+  const taken = topAndBottom();
+  taken.template = named[1];
+  taken.primarySide = sideFor(named[1], 'top');
+  const again = runCheck(lessonOf(taken)).output;
+  assert.doesNotMatch(
+    again,
+    /could not be laid out|TEXT_OVERLOAD|TABLE_ZONE_TOO_SHORT/,
+    `${named[1]} was offered and does not build the slide:\n${again.slice(-900)}`
+  );
+});
+
+test('a slide no two-part layout holds is told so, not sent round the templates', () => {
+  const { output } = runCheck(lessonOf(tooFull()));
+  if (noAutofit(output)) return;
+
+  const line = output.split(/\r?\n/).find((l) => l.startsWith('LAYOUT_OPTIONS: slide 1:'));
+  assert.ok(line, `a refused two-part slide got no layout line:\n${output.slice(-900)}`);
+  assert.match(line, /no two-part layout holds this content/);
+  assert.doesNotMatch(line, /`split-/, `a layout was named for a slide nothing holds: ${line}`);
+});
+
+test('a deck with nothing refused prints no layout line', () => {
+  const fine = topAndBottom();
+  fine.template = 'split-h-50-50';
+  fine.primarySide = 'left';
+  const { output } = runCheck(lessonOf(fine));
+  if (noAutofit(output)) return;
+  assert.doesNotMatch(output, /LAYOUT_OPTIONS/);
+});
+
+test('a trial that was never drawn names no layout', () => {
+  // A build that prints nothing has reported no faults. That is silence, not a
+  // layout that fits: the first version of this search read it as "all eleven
+  // build" and offered three layouts for slides nothing holds.
+  const root = fs.mkdtempSync(path.join(os.tmpdir(), 'layout-options-'));
+  const silent = path.join(root, 'silent-build.js');
+  fs.writeFileSync(silent, 'process.exit(1);\n');
+  const lessonPath = path.join(root, 'lesson.json');
+  const lesson = lessonOf(tooFull());
+  fs.writeFileSync(lessonPath, JSON.stringify(lesson));
+  const lines = layoutOptions(lesson, lessonPath, [1], { buildPath: silent, env: process.env });
+  fs.rmSync(root, { recursive: true, force: true });
+  assert.deepEqual(lines, []);
+});
+
+test('a question and its answer slide are tried in a layout together', () => {
+  const question = topAndBottom();
+  const answer = topAndBottom();
+  question.primary.items[0].revealPair = { id: 'read-1', state: 'question' };
+  answer.primary.items[0].revealPair = { id: 'read-1', state: 'answer' };
+  const lesson = lessonOf({ template: 'body-full', title: 'Starter', primary: { type: 'text', value: 'Hello.' } }, question, answer);
+  assert.deepEqual(groupFor(lesson, 2), [2, 3]);
+  assert.deepEqual(groupFor(lesson, 3), [2, 3]);
+  assert.deepEqual(groupFor(lesson, 1), [1]);
+});
+
+test('the main part keeps its side when the split turns', () => {
+  assert.equal(sideFor('split-h-50-50', 'top'), 'left');
+  assert.equal(sideFor('split-h-50-50', 'bottom'), 'right');
+  assert.equal(sideFor('split-v-60-40', 'right'), 'bottom');
+  assert.equal(sideFor('split-v-60-40', undefined), 'top');
+});
diff --git a/plugins/lesson-v4/builder/test/stack-lends-spare-height.test.js b/plugins/lesson-v4/builder/test/stack-lends-spare-height.test.js
