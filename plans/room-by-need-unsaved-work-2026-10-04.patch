--- /dev/null
+++ b/plugins/lesson-v4/builder/test/stack-lends-spare-height.test.js
@@ -0,0 +1,131 @@
+'use strict';
+
+// A stack lends spare height to the item beside it that is short of it.
+//
+// Year 4 Maths Lesson 21 (Subtract two 2-digit numbers, 3 October 2026) wrote
+// its answer slides as an instruction, a working table, the calculation and a
+// finished number line, each with a guessed weight. Two of those slides were
+// refused for 0.11in and 0.00in of table height while the calculation's card
+// held room it did not use, and the run spent a slide repair on them. The
+// teacher, shown the refused slide drawn anyway beside the repaired one, said
+// the table was fine either way and that he preferred the instruction on its
+// white card, which the guessed weight had cost it.
+//
+// The stack knew both numbers. These tests pin that it now moves them itself,
+// and that it moves nothing else.
+
+const test = require('node:test');
+const assert = require('node:assert/strict');
+
+const { stackLayout } = require('../src/content/stack');
+
+const CTX = { slideIndex: 0, cardLook: true };
+// The left half of a split slide, the zone those answer slides gave the stack.
+const ZONE = { x: 0.2, y: 0.6, w: 6.3, h: 6.65, class: 'C' };
+const CARD_FLOOR = 0.7;
+
+const working = (weight) => ({
+  type: 'table',
+  weight,
+  headers: ['Working'],
+  rows: [['24 = 20 + 4'], ['78 - 20 = 58'], ['58 - 4 = 54'], ['78 - 24 = 54']],
+});
+
+function answerSlide(tableWeight) {
+  return {
+    type: 'stack',
+    items: [
+      { type: 'text', value: 'Partition 24 into tens and ones.', align: 'center', weight: 0.35 },
+      working(tableWeight),
+      { type: 'text', value: '78 - 24 =', align: 'center', weight: 0.8 },
+      { type: 'numberline', weight: 1.5, start: 54, end: 78, labels: [54, 58, 78] },
+    ],
+  };
+}
+
+const sharesByWeight = (data) => {
+  const weights = data.items.map((it) => it.weight || 1);
+  const total = weights.reduce((a, b) => a + b, 0);
+  const room = ZONE.h - 0.10 * (data.items.length - 1);
+  return weights.map((w) => (room * w) / total);
+};
+
+test('a table short of row height borrows it and the slide is not refused', () => {
+  const data = answerSlide(1.6);
+  const guessed = sharesByWeight(data);
+  const laid = stackLayout(ZONE, data, CTX);
+
+  assert.ok(
+    laid[1].zone.h > guessed[1] + 0.05,
+    `the table kept its guessed ${guessed[1].toFixed(2)}in and would be refused`
+  );
+  // What was lent came out of the calculation's card, which still holds it.
+  assert.ok(laid[2].zone.h < guessed[2], 'nothing was taken from the text that had room to spare');
+  assert.ok(laid[2].zone.h >= CARD_FLOOR, `the lender was left ${laid[2].zone.h.toFixed(2)}in, under its card`);
+  // The number line cannot be measured, so it is never lent from.
+  assert.ok(Math.abs(laid[3].zone.h - guessed[3]) < 0.001, 'the number line moved');
+});
+
+test('a line of text thinner than its card is given the card back', () => {
+  const data = answerSlide(1.6);
+  const guessed = sharesByWeight(data);
+  assert.ok(guessed[0] < CARD_FLOOR, 'the fixture no longer starts with a thin line');
+
+  const laid = stackLayout(ZONE, data, CTX);
+  assert.ok(
+    laid[0].zone.h >= CARD_FLOOR,
+    `the instruction is ${laid[0].zone.h.toFixed(2)}in tall and prints bare on the background`
+  );
+});
+
+test('the items stay inside the stack, one under the next, so nothing overlaps or is cut', () => {
+  const data = answerSlide(1.6);
+  const laid = stackLayout(ZONE, data, CTX);
+  const used = laid.reduce((sum, entry) => sum + entry.zone.h, 0) + 0.10 * (laid.length - 1);
+  assert.ok(used <= ZONE.h + 0.001, `the stack now uses ${used.toFixed(3)}in of ${ZONE.h}in`);
+  for (let i = 1; i < laid.length; i += 1) {
+    const above = laid[i - 1].zone;
+    assert.ok(Math.abs(laid[i].zone.y - (above.y + above.h + 0.10)) < 0.001, `item ${i} does not sit under item ${i - 1}`);
+  }
+});
+
+test('a stack with nothing short gives its table and number line their weighted shares', () => {
+  // The same slide with every line given a card's worth of room and the table
+  // given what it needs: nothing is short, so nothing is lent. (Text that hugs
+  // its words still settles to their height, as it always has.)
+  const data = {
+    type: 'stack',
+    items: [
+      { type: 'text', value: 'Partition 24 into tens and ones.', align: 'center', weight: 0.8 },
+      working(2.2),
+      { type: 'text', value: '78 - 24 =', align: 'center', weight: 0.8 },
+      { type: 'numberline', weight: 1.2, start: 54, end: 78, labels: [54, 58, 78] },
+    ],
+  };
+  const guessed = sharesByWeight(data);
+  const laid = stackLayout(ZONE, data, CTX);
+  [1, 3].forEach((i) => {
+    assert.ok(
+      Math.abs(laid[i].zone.h - guessed[i]) < 0.001,
+      `item ${i} moved from ${guessed[i].toFixed(3)}in to ${laid[i].zone.h.toFixed(3)}in with nothing short`
+    );
+  });
+  [0, 2].forEach((i) => {
+    assert.ok(laid[i].zone.h >= CARD_FLOOR, `text ${i} was left ${laid[i].zone.h.toFixed(2)}in, under its card`);
+  });
+});
+
+test('with no text holding spare height, nothing moves and the table is left to refuse', () => {
+  const data = {
+    type: 'stack',
+    items: [
+      working(1),
+      { type: 'numberline', weight: 3, start: 54, end: 78, labels: [54, 58, 78] },
+    ],
+  };
+  const guessed = sharesByWeight(data);
+  const laid = stackLayout(ZONE, data, CTX);
+  laid.forEach((entry, i) => {
+    assert.ok(Math.abs(entry.zone.h - guessed[i]) < 0.001, `item ${i} moved with nothing to lend`);
+  });
+});
