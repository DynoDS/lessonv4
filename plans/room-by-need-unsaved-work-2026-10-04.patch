diff --git a/plugins/lesson-v4/builder/scripts/layout-options.js b/plugins/lesson-v4/builder/scripts/layout-options.js
new file mode 100644
index 00000000..9f5dfd22
--- /dev/null
+++ b/plugins/lesson-v4/builder/scripts/layout-options.js
@@ -0,0 +1,245 @@
+'use strict';
+
+// When a two-part slide is refused, say which two-part layouts hold it.
+//
+// A slide designer picks a split template from the catalogue and finds out
+// whether the content fits only when the check refuses it. It then spends its
+// repair passes trying other templates one at a time. Year 4 Maths Lesson 16
+// (Roman numerals to L, 22 September 2026) had six slides refused as
+// top-and-bottom splits, spent all three passes on their tables and went to a
+// focused repair; every one of the six lays out cleanly side by side, at
+// larger writing than the repair reached. Year 4 Maths Lesson 21 (3 October
+// 2026) had four slides that no two-part layout holds at all, which the
+// designer could only learn by trying.
+//
+// The engine can try every layout in a few seconds, so the check does, once,
+// for the refused slides only, and prints one line for each: the layouts that
+// build it cleanly, or that none does. It reports what fits; it does not
+// choose. The teacher, shown the engine's own choice against delivered slides
+// (3 October 2026), saw no difference on seven of twelve and preferred the
+// delivered slide on two, so a layout is offered only where the designer's
+// was refused.
+
+const fs = require('node:fs');
+const os = require('node:os');
+const path = require('node:path');
+const { spawnSync } = require('node:child_process');
+
+const SPLITS = [
+  'split-h-50-50', 'split-h-60-40', 'split-h-70-30', 'split-h-75-25', 'split-h-80-20', 'split-h-90-10',
+  'split-v-50-50', 'split-v-60-40', 'split-v-70-30', 'split-v-75-25', 'split-v-80-20', 'split-v-90-10',
+];
+// A deck with many refused slides is a deck to rethink, and every slide tried
+// costs a dozen drawn pages, so the search stops here and says so.
+const MOST_SLIDES = 8;
+const MOST_NAMED = 3;
+const READABLE_PT = 20;
+
+function isTwoPart(slide) {
+  return !!slide && SPLITS.includes(slide.template) &&
+    slide.primary && typeof slide.primary === 'object' &&
+    slide.secondary && typeof slide.secondary === 'object';
+}
+
+// The same side of the slide where the orientation is kept; its counterpart
+// where the split turns from side by side to top and bottom or back.
+function sideFor(template, current) {
+  const horizontal = template.startsWith('split-h-');
+  const first = current === 'right' || current === 'bottom' ? 1 : 0;
+  return (horizontal ? ['left', 'right'] : ['top', 'bottom'])[first];
+}
+
+function pairIds(node, found) {
+  if (Array.isArray(node)) {
+    node.forEach((item) => pairIds(item, found));
+  } else if (node && typeof node === 'object') {
+    if (node.revealPair && typeof node.revealPair.id === 'string') found.add(node.revealPair.id);
+    Object.keys(node).forEach((key) => {
+      if (key !== 'revealPair') pairIds(node[key], found);
+    });
+  }
+  return found;
+}
+
+function renamePairs(node, suffix) {
+  if (Array.isArray(node)) return node.map((item) => renamePairs(item, suffix));
+  if (!node || typeof node !== 'object') return node;
+  const out = {};
+  Object.keys(node).forEach((key) => {
+    out[key] = key === 'revealPair' && node[key] && typeof node[key].id === 'string'
+      ? { ...node[key], id: `${node[key].id}${suffix}` }
+      : renamePairs(node[key], suffix);
+  });
+  return out;
+}
+
+// A question and its answer slide share one layout, so a refused slide is tried
+// together with every slide it is paired with.
+function groupFor(lesson, slideNumber) {
+  const slides = lesson.slides;
+  const ids = pairIds(slides[slideNumber - 1], new Set());
+  const group = [slideNumber];
+  if (ids.size) {
+    slides.forEach((slide, index) => {
+      if (index + 1 === slideNumber) return;
+      const theirs = pairIds(slide, new Set());
+      if ([...theirs].some((id) => ids.has(id))) group.push(index + 1);
+    });
+  }
+  return group.sort((a, b) => a - b);
+}
+
+function parseTrial(output) {
+  const faulty = new Set();
+  const small = new Map();
+  let inSmall = false;
+  for (const line of String(output || '').split(/\r?\n/)) {
+    if (line.startsWith('BUILD_DIAGNOSTIC: ')) {
+      try {
+        const d = JSON.parse(line.slice('BUILD_DIAGNOSTIC: '.length));
+        if (d && d.faultClass !== 'note' && d.location && Number.isFinite(d.location.slide)) {
+          faulty.add(d.location.slide);
+        }
+      } catch {
+        // An unreadable line cannot vouch for a layout, and none is named on it.
+      }
+      continue;
+    }
+    if (line.startsWith('SLIDE_TEXT_BELOW_TARGET:')) { inSmall = true; continue; }
+    const row = inSmall ? /^\s+slide (\d+) at (\d+)pt: "(.*)"\s*$/.exec(line) : null;
+    if (row) {
+      const slide = Number(row[1]);
+      if (!small.has(slide)) small.set(slide, []);
+      small.get(slide).push({ pt: Number(row[2]), text: row[3] });
+    } else if (inSmall && line.trim() !== '') {
+      inSmall = false;
+    }
+  }
+  return { faulty, small };
+}
+
+function names(list) {
+  const shown = list.slice(0, MOST_NAMED).map((entry) => `\`${entry.template}\``);
+  if (shown.length <= 1) return shown.join('');
+  return `${shown.slice(0, -1).join(', ')} or ${shown[shown.length - 1]}`;
+}
+
+function layoutOptions(lesson, jsonPath, refusedSlides, options = {}) {
+  const slides = Array.isArray(lesson && lesson.slides) ? lesson.slides : [];
+  const wanted = [...new Set(refusedSlides)]
+    .filter((n) => Number.isInteger(n) && isTwoPart(slides[n - 1]))
+    .sort((a, b) => a - b);
+  if (!wanted.length) return [];
+
+  // One search per group: a question and its answer are refused together.
+  const groups = [];
+  const covered = new Set();
+  wanted.forEach((n) => {
+    if (covered.has(n)) return;
+    const group = groupFor(lesson, n);
+    if (!group.every((member) => isTwoPart(slides[member - 1]))) return;
+    group.forEach((member) => covered.add(member));
+    groups.push(group);
+  });
+  if (!groups.length) return [];
+  const searched = groups.slice(0, MOST_SLIDES);
+  const lines = [];
+  if (groups.length > searched.length) {
+    lines.push(
+      `LAYOUT_OPTIONS: ${groups.length} refused two-part slides; only the first ${searched.length} ` +
+      'were tried in other layouts.'
+    );
+  }
+
+  // One trial deck: every searched group in every layout but its own.
+  const trialSlides = [];
+  const trials = [];
+  searched.forEach((group, g) => {
+    const current = slides[group[0] - 1];
+    SPLITS.forEach((template, t) => {
+      if (template === current.template) return;
+      const numbers = [];
+      group.forEach((member) => {
+        const copy = renamePairs(JSON.parse(JSON.stringify(slides[member - 1])), `x${g}y${t}`);
+        copy.template = template;
+        copy.primarySide = sideFor(template, slides[member - 1].primarySide);
+        trialSlides.push(copy);
+        numbers.push(trialSlides.length);
+      });
+      trials.push({ group: g, template, numbers });
+    });
+  });
+
+  const trialPath = path.join(
+    path.dirname(jsonPath),
+    `.${path.basename(jsonPath)}.layout-options-${process.pid}.json`
+  );
+  let scratchDir = null;
+  let output = '';
+  try {
+    // The build draws a design preview only into a slide-design-check scratch
+    // directory, so the trial deck uses one of its own.
+    scratchDir = fs.mkdtempSync(path.join(os.tmpdir(), 'lesson-resources-slide-design-check-'));
+    fs.writeFileSync(trialPath, JSON.stringify({ ...lesson, slides: trialSlides }));
+    const child = spawnSync(
+      process.execPath,
+      [options.buildPath, trialPath, scratchDir, '--design-preview', '--skip-optional-decorations'],
+      { encoding: 'utf8', stdio: ['ignore', 'pipe', 'pipe'], maxBuffer: 20 * 1024 * 1024, env: options.env || process.env }
+    );
+    if (child.error) return [];
+    output = `${child.stdout || ''}\n${child.stderr || ''}`;
+  } catch {
+    return [];
+  } finally {
+    try {
+      fs.rmSync(trialPath, { force: true });
+      if (scratchDir) fs.rmSync(scratchDir, { recursive: true, force: true });
+    } catch {
+      // Nothing the search leaves behind changes the check's verdict.
+    }
+  }
+  // The search is a help beside a refusal that already stands, so it speaks
+  // only on evidence. A trial deck that was never drawn reports no faults, and
+  // silence is not a layout that fits: unless the build says it wrote the
+  // pages, and the text fitting pass ran, nothing is named.
+  if (!/^(PARTIAL_PREVIEW|Wrote): /m.test(output)) return [];
+  if (/AUTOFIT_(DEPENDENCY_MISSING|NOT_PERMITTED|PROCESS_FAILED)/.test(output)) return [];
+
+  const { faulty, small } = parseTrial(output);
+  searched.forEach((group, g) => {
+    const mine = trials.filter((trial) => trial.group === g);
+    const built = mine.filter((trial) => trial.numbers.every((n) => !faulty.has(n)));
+    const where = group.length > 1 ? `slides ${group.join(' and ')}` : `slide ${group[0]}`;
+    if (!built.length) {
+      lines.push(
+        `LAYOUT_OPTIONS: ${where}: no two-part layout holds this content at a readable size ` +
+        `(all ${mine.length} others were tried). Changing the template will not mend it: carry the ` +
+        'beat across two slides, or regroup what the slide holds.'
+      );
+      return;
+    }
+    // Writing every layout prints small (a signal chip) says nothing about a
+    // layout; writing only some print small is what tells them apart.
+    const inAll = (text) => built.every((trial) =>
+      trial.numbers.some((n) => (small.get(n) || []).some((box) => box.text === text)));
+    built.forEach((trial) => {
+      trial.smallest = Math.min(READABLE_PT, ...trial.numbers.flatMap((n) =>
+        (small.get(n) || []).filter((box) => !inAll(box.text)).map((box) => box.pt)));
+    });
+    const clean = built.filter((trial) => trial.smallest >= READABLE_PT);
+    const tight = built.filter((trial) => trial.smallest < READABLE_PT)
+      .sort((a, b) => b.smallest - a.smallest);
+    let line = `LAYOUT_OPTIONS: ${where}: `;
+    if (clean.length) {
+      line += `this content builds with all its writing at ${READABLE_PT}pt or more as ${names(clean)}`;
+      if (tight.length) line += `; as ${names(tight)} some of it drops to ${tight[0].smallest}pt`;
+    } else {
+      line += `this content builds as ${names(tight)}, with some writing at ${tight[0].smallest}pt`;
+    }
+    line += '. Take one of these rather than adjusting the refused layout, then look at the page.';
+    lines.push(line);
+  });
+  return lines;
+}
+
+module.exports = { layoutOptions, isTwoPart, groupFor, sideFor, SPLITS };
